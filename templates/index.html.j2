<!DOCTYPE html>
<html lang="en">
<head>
    {% if data.site and data.site.google_analytics_id %}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ data.site.google_analytics_id }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ data.site.google_analytics_id }}');
    </script>
    {% endif %}

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ data.person.name }}, {{ data.person.degrees }}</title>
    <meta name="description" content="{{ data.person.description }}">
    <link rel="canonical" href="{{ data.person.url }}">
    <link rel="alternate" type="text/markdown" href="{{ data.person.url }}llms.txt" title="LLMs.txt">

    <!-- Open Graph Metadata -->
    <meta property="og:site_name" content="{{ data.person.name }}">
    <meta property="og:title" content="{{ data.person.name }}, {{ data.person.degrees }}">
    <meta property="og:description" content="{{ data.person.description }}">
    <meta property="og:url" content="{{ data.person.url }}">
    <meta property="og:type" content="profile">
    <meta property="og:image" content="{{ data.person.url }}{{ data.person.image }}">

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ data.person.name }}, {{ data.person.degrees }}">
    <meta name="twitter:description" content="{{ data.person.description }}">
    <meta name="twitter:image" content="{{ data.person.url }}{{ data.person.image }}">

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": {{ data.person.name | tojson }},
      "jobTitle": {{ data.person.title | tojson }},
      "description": {{ data.person.description | tojson }},
      "url": {{ data.person.url | tojson }},
      "image": {{ (data.person.url ~ data.person.image) | tojson }},
      "sameAs": [
        {%- set same_as_links = [] -%}
        {%- for link in data.social if link.url.startswith('http') -%}
          {%- set _ = same_as_links.append(link.url) -%}
        {%- endfor -%}
        {%- for url in same_as_links -%}
        {{ url | tojson }}{% if not loop.last %}, {% endif %}
        {%- endfor -%}
      ],
      "worksFor": [
        {%- set companies = [] -%}
        {%- for job in data.experience -%}
          {%- if job.company not in companies -%}
            {%- set _ = companies.append(job.company) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for comp in companies -%}
        {
          "@type": "Organization",
          "name": {{ comp | tojson }}
        }{% if not loop.last %}, {% endif %}
        {%- endfor -%}
      ],
      "alumniOf": [
        {%- set institutions = [] -%}
        {%- for edu in data.education -%}
          {%- if edu.institution not in institutions -%}
            {%- set _ = institutions.append(edu.institution) -%}
          {%- endif -%}
        {%- endfor -%}
        {%- for inst in institutions -%}
        {
          "@type": "EducationalOrganization",
          "name": {{ inst | tojson }}
        }{% if not loop.last %}, {% endif %}
        {%- endfor -%}
      ]
    }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/brands.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/solid.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/fontawesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <section class="hero">
        <div class="hero-head">
            <nav class="navbar">
                <div class="container">
                    <div class="navbar-brand">
                        <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarMenu">
                            <span aria-hidden="true"></span>
                            <span aria-hidden="true"></span>
                            <span aria-hidden="true"></span>
                        </a>
                    </div>

                    <div id="navbarMenu" class="navbar-menu">
                        <div class="navbar-end">
                            <a class="navbar-item" onclick="scrollToSection('experience')">Experience</a>
                            <a class="navbar-item" onclick="scrollToSection('education')">Education</a>
                            <a class="navbar-item" onclick="scrollToSection('profile')">Profile</a>
                        </div>
                    </div>
                </div>
            </nav>
        </div>

        <div class="hero-body">
            <div class="container is-centered has-text-centered">
                    <h1>
                        <span class="has-text-primary">{{ data.person.first_name }}</span> {{ data.person.last_name }}, <span class="has-text-primary">{{ data.person.degrees | lower }}</span>
                    </h1>
                    <h2>
                        {{ data.person.title }}
                    </h2>
                    <div class="social-icons">
                        {% for link in data.social %}
                        <a href="{{ link.url }}"{% if link.target %} target="{{ link.target }}"{% endif %} title="{{ link.name }}">
                            <i class="{{ link.icon }}"></i>
                        </a>
                        {% endfor %}
                    </div>
                </div>
        </div>
    </section>

    <section id="experience" class="section-slide section-experience">
        <div class="container is-centered">
            <h2>Experience</h2>

            <div class="experience-list">
                {% for job in data.experience %}
                <div class="experience-item">
                    <h3>{{ job.role }}</h3>
                    <h4>{% if job.team %}{{ job.team }}, {% endif %}{{ job.company }}</h4>
                    <h5>{{ job.start }} - {{ job.end }}</h5>
                    {% for item in job.achievements %}
                    <p>{{ item }}</p>
                    {% endfor %}
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="education" class="section-slide section-education">
        <div class="container is-centered">
            <h2>Education</h2>

            <div class="education-list">
                {% for edu in data.education %}
                <div class="education-item">
                    <div class="degree-line">
                        <span class="degree">{{ edu.degree }}</span>,
                        <span class="institution">{{ edu.institution }}</span>
                    </div>
                    {% if edu.awards %}
                    <div class="awards-text">
                        {{ edu.awards | join(',\n                        ') }}.
                    </div>
                    {% elif edu.notes %}
                    <div class="awards-text">
                        {{ edu.notes }}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="profile" class="section-slide section-profile">
        <div class="container is-centered has-text-centered">
            <h2>Profile</h2>

            <div class="profile-content">
                <img class="is-1by1" src="{{ data.person.image }}" alt="{{ data.person.name }}">
                <p>{{ data.person.bio }}</p>
            </div>
        </div>
    </section>

    <!-- Return to top Button -->
    <button class="return-to-top" onclick="scrollToTop()" title="Return to top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <script>
        // Smooth scroll to section
        function scrollToSection(sectionId) {
            document.getElementById(sectionId).scrollIntoView({
                behavior: 'smooth'
            });
        }

        // Scroll to top function
        function scrollToTop() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Show/hide return to top button
            function handleScroll() {
                const returnToTopBtn = document.querySelector('.return-to-top');
                const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

                if (scrollTop > 300) {
                    returnToTopBtn.classList.add('show');
                } else {
                    returnToTopBtn.classList.remove('show');
                }
            }
            window.addEventListener('scroll', handleScroll);

            // Mobile menu toggle
            const $navbarBurgers = document.querySelectorAll('.navbar-burger');
            if ($navbarBurgers.length > 0) {
                $navbarBurgers.forEach(el => {
                    el.addEventListener('click', () => {
                        const target = el.dataset.target;
                        const $target = document.getElementById(target);

                        el.classList.toggle('is-active');
                        $target.classList.toggle('is-active');
                    });
                });
            }

            // Close mobile menu when clicking on menu items
            document.querySelectorAll('.navbar-item[onclick]').forEach(item => {
                item.addEventListener('click', () => {
                    document.querySelector('.navbar-burger')?.classList.remove('is-active');
                    document.querySelector('.navbar-menu')?.classList.remove('is-active');
                });
            });
        });
    </script>
</body>
</html>
